# Copy to .env for local dev (npm run dev). On Render, set these in the service's Environment tab.
# Never commit real values.

# --- required ---
GROQ_API_KEY=gsk_...
GEMINI_API_KEY=...
# MongoDB Atlas connection string. Unset locally to use data/db.json instead.
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/
# Signs login sessions; any long random string. Without it everyone is signed out on restart.
AUTH_SECRET=

# --- optional ---
# Database name inside the cluster (default lectureiq_app).
MONGODB_DB=lectureiq_app
# One-tap sign-in to real, empty test accounts (Test Professor / Test Student). false hides it.
DEMO_MODE=true
# Require this code to register as a professor.
FACULTY_CODE=
# Shared secret the app must send as x-app-key. Leave empty unless the app is built with --dart-define=APP_KEY=...
APP_KEY=
GEMINI_MODEL=gemini-2.5-flash
GROQ_STT_MODEL=whisper-large-v3-turbo
GROQ_LLM_MODEL=openai/gpt-oss-120b
# Local file storage directory (only used without MONGODB_URI).
DATA_DIR=data
