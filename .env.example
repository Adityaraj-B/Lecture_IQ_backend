# Server
PORT=3000
NODE_ENV=development

# MongoDB
MONGO_URI=mongodb://localhost:27017/lectureiq

# Redis (for BullMQ)
REDIS_URL=redis://localhost:6379

# JWT
JWT_SECRET=your_jwt_secret_here_change_in_production
JWT_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=10
# Google Cloud Storage (no longer used — replaced by Cloudinary)
# GCS_BUCKET=lectureiq-audio-chunks
# GOOGLE_APPLICATION_CREDENTIALS=./service-account.json

# Cloudinary (primary audio storage backend — free, no credit card required)
CLOUDINARY_CLOUD_NAME=your_cloud_name_here
CLOUDINARY_API_KEY=your_api_key_here
CLOUDINARY_API_SECRET=your_api_secret_here

# Firebase
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json

# STT Provider: 'mock' | 'bhashini' | 'google'
STT_PROVIDER=mock
# STT Provider: 'gemini' | 'mock' | 'bhashini' | 'google'
STT_PROVIDER=gemini

# Bhashini STT (if STT_PROVIDER=bhashini)
BHASHINI_API_KEY=
BHASHINI_USER_ID=
BHASHINI_PIPELINE_ID=

# Google Cloud STT (if STT_PROVIDER=google)
# Uses GOOGLE_APPLICATION_CREDENTIALS above

# LLM Provider: 'gemini' | 'mock' | 'openai' | 'anthropic'
LLM_PROVIDER=gemini

# Google Gemini API Key (used for both STT and LLM)
GEMINI_API_KEY=
LLM_API_KEY=
# For Anthropic
ANTHROPIC_API_KEY=
# For OpenAI
OPENAI_API_KEY=
